{
    "name": "saccharine/bpmn-engine",
    "description": "Laravel BPMN Execution Engine",
    "license": "MIT",
    "keywords": ["laravel", "bpmn", "workflow", "camunda", "orchestration"],
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/expression-language": "^7.0",
        "durable-workflow/workflow": "^1.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saccharine\\BpmnEngine\\BpmnEngineServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Saccharine\\BpmnEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saccharine\\BpmnEngine\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Matthew Wegner",
            "email": "mwegner@proton.me"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
